<Window x:Class="Hs80.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hardware check"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource CardBrush}"
        FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="DetailText"
                   Margin="0,8,0,0"
                   FontSize="12"
                   Foreground="{StaticResource TextDimBrush}"
                   TextWrapping="Wrap"/>
        <TextBlock x:Name="HintText"
                   Margin="0,16,0,0"
                   FontSize="11"
                   Foreground="{StaticResource AccentBrush}"
                   TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="RetryBtn"
                    Content="Repaint and retry"
                    Style="{StaticResource DarkButton}"
                    Click="OnRetry"/>
            <Button x:Name="OkBtn"
                    Content="Looks right"
                    Style="{StaticResource AccentButton}"
                    Margin="10,0,0,0"
                    IsDefault="True"
                    Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
