<Window x:Class="Hs80.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hs80.App.Controls"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="HS80 MAX Control"
        Width="1120" Height="566"
        MinWidth="900" MinHeight="520"
        Icon="/Assets/app.ico"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- title bar -->
        <Border Grid.Row="0"
                Background="{StaticResource BgBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTitleBarDrag">
            <Grid>
                <TextBlock Text="HS80 MAX Control"
                           FontSize="12"
                           Foreground="{StaticResource TextDimBrush}"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="&#x2500;" Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="Minimize"/>
                    <Button Content="&#x25A1;" Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick" ToolTip="Maximize"/>
                    <Button Content="&#x2715;" Style="{StaticResource TitleBarButton}" Click="OnCloseClick" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- rail -->
            <Border Grid.Column="0"
                    Background="{StaticResource RailBrush}"
                    BorderBrush="{StaticResource HairlineBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="14,14,14,14">
                        <TextBlock Text="HS80 MAX" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Ellipse x:Name="LinkDot" Style="{StaticResource Dot}" Fill="{StaticResource TextMuteBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LinkText" Text="--" Style="{StaticResource MicroLabel}" Margin="6,0,0,0"/>
                            <Ellipse x:Name="MicDot" Style="{StaticResource Dot}" Fill="{StaticResource TextMuteBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MicText" Text="--" Style="{StaticResource MicroLabel}" Margin="6,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock x:Name="BatteryPercent" Text="--%" Style="{StaticResource BatteryValue}"/>
                            <TextBlock x:Name="EtaText" Text="ETA --" Style="{StaticResource MicroLabel}" Margin="8,0,0,2" VerticalAlignment="Bottom"/>
                        </StackPanel>
                        <TextBlock x:Name="ChargeState" Text="--" Style="{StaticResource MicroLabel}" Margin="0,2,0,0"/>
                        <Grid Height="40" Margin="0,10,0,0">
                            <Polyline x:Name="SparklinePath" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1" Stretch="Fill"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,0">
                        <RadioButton x:Name="NavLights" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2h5c0-.8.4-1.5 1-2A6 6 0 0 0 12 3Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Lights" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSounds" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M11 5 6 9H3v6h3l5 4V5ZM15.5 8.5a5 5 0 0 1 0 7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="Sounds" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4.1a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,11,0"/>
                                <TextBlock Text="System" VerticalAlignment="Center"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="14,0,14,10">
                        <Border Background="{StaticResource CardAltBrush}" Width="30" Height="30" CornerRadius="3" HorizontalAlignment="Left">
                            <Grid>
                                <Image x:Name="ThumbImage" Stretch="UniformToFill" Visibility="Collapsed"/>
                                <TextBlock x:Name="ThumbFallback" Text="&#x266A;" FontSize="14" Foreground="{StaticResource TextMuteBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="NowTitle" Text="Nothing playing" FontSize="12" Foreground="{StaticResource TextBrush}"
                                   Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowArtist" Text="" Style="{StaticResource MicroLabel}"
                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="NowAlbum" Text="" Style="{StaticResource MicroLabel}" Visibility="Collapsed"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" x:Name="VersionText" Text="Interface 0.0.0" Style="{StaticResource MicroLabel}"
                               Margin="14,0,14,10" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>

            <!-- content -->
            <Grid Grid.Column="1">

                <!-- LIGHTS -->
                <Grid x:Name="PaneLights" Margin="24,20,24,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Lights" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Writes to the headset immediately" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,14,0,0" Height="44">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brightness" VerticalAlignment="Center"/>
                        <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="1000" Value="500"
                                Style="{StaticResource DarkSlider}" VerticalAlignment="Center"
                                ValueChanged="OnBrightnessValue" Thumb.DragCompleted="OnBrightnessDrag"/>
                        <TextBlock x:Name="BrightnessValue" Grid.Column="2" Text="500" Style="{StaticResource MicroLabel}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2" Height="29" Margin="0,1,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Zone" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="Colour" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <StackPanel Grid.Row="3">
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Earcups" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Both cups" Style="{StaticResource MicroLabel}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <local:ColorPicker x:Name="EarcupsPicker" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mic tip" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="Boom end" Style="{StaticResource MicroLabel}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <local:ColorPicker x:Name="MicPicker" Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="52">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Mic tip muted" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="When the boom is up" Style="{StaticResource MicroLabel}" Margin="0,1,0,0"/>
                                </StackPanel>
                                <local:ColorPicker x:Name="MicMutedPicker" Grid.Column="1" VerticalAlignment="Center" IsEnabled="False"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Follow the boom lever" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Swap the mic tip colour when muted" Style="{StaticResource MicroLabel}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="MicFollowMuteCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}"
                                          VerticalAlignment="Center" Checked="OnMicFollowMuteChanged" Unchecked="OnMicFollowMuteChanged"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- SOUNDS -->
                <Grid x:Name="PaneSounds" Margin="24,20,24,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Sounds" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="What the app does when the headset reports an event" Style="{StaticResource MicroLabel}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                    </Grid>


                    <ListBox Grid.Row="2" x:Name="EventList" Style="{StaticResource DarkListBox}"
                             ItemContainerStyle="{StaticResource DarkListBoxItem}"
                             SelectionChanged="OnEventSelected"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="40">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="196"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding TriggerCondition}" Style="{StaticResource MicroLabel}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Background="{StaticResource CardAltBrush}" Margin="0,10,0,0" Padding="14">
                        <StackPanel x:Name="BindingEditor" IsEnabled="False">
                            <TextBlock x:Name="BindingTitle" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="BindingDesc" Style="{StaticResource MicroLabel}" TextWrapping="Wrap" Margin="0,3,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="250"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0">
                                    <TextBlock Text="Sound" Style="{StaticResource MicroLabel}" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="AudioPresetBox" Style="{StaticResource DarkComboBox}" SelectionChanged="OnAudioPresetChanged">
                                        <ComboBoxItem Content="No audio"/>
                                        <ComboBoxItem Content="Low battery"/>
                                        <ComboBoxItem Content="Disconnect"/>
                                        <ComboBoxItem Content="Connect"/>
                                        <ComboBoxItem Content="Mic mute"/>
                                        <ComboBoxItem Content="Mic unmute"/>
                                        <ComboBoxItem Content="CH_Call_Ended"/>
                                        <ComboBoxItem Content="CH_Call_Rejected"/>
                                        <ComboBoxItem Content="CH_Connected"/>
                                        <ComboBoxItem Content="CH_Disconnected"/>
                                        <ComboBoxItem Content="CH_Enter_Pairing_Mode"/>
                                        <ComboBoxItem Content="CH_Incoming_Call"/>
                                        <ComboBoxItem Content="CH_Incoming_Call_Ended"/>
                                        <ComboBoxItem Content="CH_Low_Battery"/>
                                        <ComboBoxItem Content="CH_Power_OFF"/>
                                        <ComboBoxItem Content="CH_Power_ON"/>
                                        <ComboBoxItem Content="Doorbell"/>
                                        <ComboBoxItem Content="Double"/>
                                        <ComboBoxItem Content="EN_Call_Ended"/>
                                        <ComboBoxItem Content="EN_Call_Rejected"/>
                                        <ComboBoxItem Content="EN_Connected"/>
                                        <ComboBoxItem Content="EN_Disconnected"/>
                                        <ComboBoxItem Content="EN_Incoming_Call"/>
                                        <ComboBoxItem Content="EN_Incoming_Call_Ended"/>
                                        <ComboBoxItem Content="EN_Low_Battery"/>
                                        <ComboBoxItem Content="EN_Pairing"/>
                                        <ComboBoxItem Content="EN_Power_OFF"/>
                                        <ComboBoxItem Content="EN_Power_ON"/>
                                        <ComboBoxItem Content="Failed"/>
                                        <ComboBoxItem Content="Pressed"/>
                                        <ComboBoxItem Content="Successed"/>
                                        <ComboBoxItem Content="Twc_Incoming_Call"/>
                                        <ComboBoxItem Content="bton"/>
                                        <ComboBoxItem Content="doff"/>
                                        <ComboBoxItem Content="don"/>
                                        <ComboBoxItem Content="eq"/>
                                        <ComboBoxItem Content="eq2"/>
                                        <ComboBoxItem Content="eq3"/>
                                        <ComboBoxItem Content="eq4"/>
                                        <ComboBoxItem Content="hftd"/>
                                        <ComboBoxItem Content="hftd_x2"/>
                                        <ComboBoxItem Content="lb"/>
                                        <ComboBoxItem Content="lftd"/>
                                        <ComboBoxItem Content="mic_close_16kHz_16bit"/>
                                        <ComboBoxItem Content="mic_open_16kHz_16bit"/>
                                        <ComboBoxItem Content="moff"/>
                                        <ComboBoxItem Content="mon"/>
                                        <ComboBoxItem Content="not_connected_16k_16bit"/>
                                        <ComboBoxItem Content="poff"/>
                                        <ComboBoxItem Content="pon"/>
                                        <ComboBoxItem Content="soff"/>
                                        <ComboBoxItem Content="son"/>
                                    </ComboBox>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button DockPanel.Dock="Right" Content="Preview" Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="OnPreviewClick"/>
                                        <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource DarkButton}" Margin="8,0,0,0" Click="OnBrowseAudio"/>
                                        <TextBox x:Name="CustomAudioPath" Style="{StaticResource DarkTextBox}" FontSize="11" TextChanged="OnCustomPathChanged"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Volume" Style="{StaticResource MicroLabel}" Margin="0,0,0,4"/>
                                    <DockPanel>
                                        <TextBlock x:Name="VolumeValue" DockPanel.Dock="Right" Style="{StaticResource MicroLabel}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="100" Value="15" Style="{StaticResource DarkSlider}"/>
                                    </DockPanel>
                                    <CheckBox x:Name="ToastCheck" Content="Tray toast" Style="{StaticResource DarkCheckBox}" Margin="0,10,0,0"
                                              Checked="OnToastChanged" Unchecked="OnToastChanged"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="LED on event" Style="{StaticResource MicroLabel}" Margin="0,10,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="Led0Enable" Content="Earcups" Style="{StaticResource DarkCheckBox}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnLedToggleChanged" Unchecked="OnLedToggleChanged"/>
                                <local:ColorPicker x:Name="BindingLed0" IsEnabled="False" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="Led1Enable" Content="Mic" Style="{StaticResource DarkCheckBox}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" Checked="OnLedToggleChanged" Unchecked="OnLedToggleChanged"/>
                                <local:ColorPicker x:Name="BindingLed1" IsEnabled="False" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- SYSTEM -->
                <Grid x:Name="PaneSystem" Margin="24,20,24,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="System" Style="{StaticResource SectionTitle}"/>

                    <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start with Windows" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="HKCU Run key, no admin" Style="{StaticResource RowHint}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="StartupCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnStartupToggle" Unchecked="OnStartupToggle"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Loopback HTTP server" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="127.0.0.1 only, no auth" Style="{StaticResource RowHint}" VerticalAlignment="Center"/>
                                <CheckBox x:Name="HttpToggle" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center"
                                          Checked="OnHttpToggle" Unchecked="OnHttpToggle"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Port" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="GET /battery · POST /led" Style="{StaticResource RowHint}" VerticalAlignment="Center"/>
                                <TextBox x:Name="HttpPortBox" Grid.Column="2" Width="72" MinHeight="28" VerticalAlignment="Center" Text="8765" Style="{StaticResource DarkTextBox}"
                                         TextChanged="OnHttpPortChanged"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interface version" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Stamped from the release it was built from" Style="{StaticResource RowHint}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="BuildVersionText" Grid.Column="2" Text="0.0.0" Style="{StaticResource RowValue}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Protocol" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Reverse engineered by ToastKiste21, MIT" Style="{StaticResource RowHint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="0xFF42" Style="{StaticResource RowValue}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Interface" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Built by BrokeSkill" Style="{StaticResource RowHint}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Style="{StaticResource RowValue}" VerticalAlignment="Center">
                                    <Hyperlink NavigateUri="https://github.com/BrokeSkill" RequestNavigate="OnLinkClick"
                                               Foreground="{StaticResource AccentBrush}"><Run Text="MIT"/></Hyperlink>
                                </TextBlock>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- status bar -->
        <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="DevStateText" Text="" Style="{StaticResource MicroLabel}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ApplyStatus" Text="" Style="{StaticResource MicroLabel}" HorizontalAlignment="Right" Margin="0,0,14,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
